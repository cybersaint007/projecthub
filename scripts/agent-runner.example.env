# ProjectHub Agent Runner — Environment Configuration
# =====================================================
# Copy this file to agent-runner.env in the same directory and fill in your values.
# Variables already set in your shell environment take precedence over this file.
#
# Usage:
#   cp scripts/agent-runner.example.env scripts/agent-runner.env
#   # edit agent-runner.env
#   php scripts/agent-runner.php

# ── Required ──────────────────────────────────────────────────────────────────

# Base URL of your ProjectHub instance (no trailing slash)
AGENT_API_BASE=https://projecthub.example.com

# Bearer token from the agent_tokens table (project-scoped)
# Generate one in ProjectHub admin or via: php artisan tinker
#   AgentToken::create(['project_id' => 7, 'name' => 'dev-mac', 'token' => Str::random(64)])
AGENT_TOKEN=your-agent-token-here

# ProjectHub project ID to pull tasks from
AGENT_PROJECT_ID=7

# ── Optional ──────────────────────────────────────────────────────────────────

# Agent type filter — only tasks with this agent type will be picked up
# Must match a value in Task::AGENTS (e.g. claude_code or codex)
AGENT_TYPE=claude_code

# Optional: restrict the agent to tasks within a specific epic.
# When set, only tasks belonging to this epic ID will be picked up.
# Leave unset or empty to run tasks from all epics (default behavior).
# AGENT_EPIC_ID=42

# Unique identifier for this worker machine (used for lease tracking)
# Defaults to the system hostname
AGENT_WORKER_ID=macmini-m2-dev

# Absolute path to the git repository the agent will work in
# claude CLI is invoked from this directory
# Defaults to the current working directory
AGENT_REPO_PATH=/Users/dev/Sites/myproject

# Seconds to wait between polls when no tasks are available (default: 30)
AGENT_POLL_INTERVAL=30

# Seconds to pause when a rate/usage limit is detected (default: 300 = 5 min)
AGENT_RATE_LIMIT_COOLDOWN=300

# Set to true to fetch the next task bundle and print the prompt without
# invoking claude. Useful for previewing what the agent would do.
# Equivalent to passing --dry-run on the command line.
AGENT_DRY_RUN=false

# Extra flags passed to the claude CLI (space-separated).
# --print is always prepended automatically.
# --dangerously-skip-permissions is required for non-interactive automation;
#   it allows claude to use tools (read/write files, run commands) without
#   pausing for permission prompts. Only use this on trusted tasks.
AGENT_CLAUDE_FLAGS=--dangerously-skip-permissions
