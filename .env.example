# Mail (password reset)
# For no SMTP (emails to storage/logs/laravel.log): MAIL_MAILER=log
# For Gmail: MAIL_MAILER=smtp, use App Password (Google Account → Security → App passwords)
# If mail not delivered: run "php artisan config:clear" then "php artisan mail:test your@email.com" to see errors
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-gmail@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
