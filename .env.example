APP_NAME=ProjectHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── Database ───────────────────────────────────────────────────────────────────
# For local development you can use SQLite (default below) or PostgreSQL.
# Production requires PostgreSQL.

# SQLite (local dev — no server needed)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# PostgreSQL (production / staging)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=projecthub
# DB_USERNAME=projecthub_user
# DB_PASSWORD=
# DB_SCHEMA=root

# ── Session / Cache / Queue ────────────────────────────────────────────────────
SESSION_DRIVER=file
CACHE_DRIVER=array
QUEUE_CONNECTION=sync

# Production recommendations:
# SESSION_DRIVER=cookie
# CACHE_DRIVER=redis
# QUEUE_CONNECTION=redis

# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ── Mail ───────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@example.com
# MAIL_FROM_NAME="${APP_NAME}"

# ── i18n / GeoIP ──────────────────────────────────────────────────────────────
# Optional: enables automatic locale detection by visitor IP address.
# Obtain a free licence at https://www.maxmind.com/en/geolite2/signup
# MAXMIND_LICENSE_KEY=

# Path relative to storage/app where the GeoLite2-Country.mmdb is stored.
# The deploy script downloads this file automatically when MAXMIND_LICENSE_KEY is set.
GEOIP_DB_PATH=app/geoip/GeoLite2-Country.mmdb
